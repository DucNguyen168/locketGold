# Shadowrocket Configuration — dj dev build
# Base: Góc Nhỏ Locket All In One (20261114_v2)
# Giữ nguyên: Locket Gold full stack (RevenueCat, Firebase, Photobooth, iTunes)
# Thêm: AI services routing qua PROXY
# Bỏ: YouTube, Spotify, SoundCloud, PicsArt, Wink, Truecaller,
#      Lightroom, Kinemaster, CamScanner, BeautyPlus, Snow, Meitu,
#      AlightMotion, VSCO, Sub-Store

[Rule]
# Block QUIC/HTTP3 — ép TCP để Shadowrocket can thiệp HTTPS
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,googleapis.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,revenuecat.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,cloudfunctions.net)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,locketcamera.com)),REJECT-NO-DROP

# Block Firebase Realtime Config push
DOMAIN,firebaseremoteconfigrealtime.googleapis.com,REJECT

# === AI Services — route through PROXY ===
# OpenAI / ChatGPT / Sora
DOMAIN-SUFFIX,openai.com,PROXY
DOMAIN-SUFFIX,chatgpt.com,PROXY
DOMAIN-SUFFIX,oaistatic.com,PROXY
DOMAIN-SUFFIX,oaiusercontent.com,PROXY
DOMAIN-SUFFIX,auth0.com,PROXY

# Anthropic / Claude
DOMAIN-SUFFIX,anthropic.com,PROXY
DOMAIN-SUFFIX,claude.ai,PROXY
DOMAIN-SUFFIX,claude.com,PROXY
DOMAIN-SUFFIX,anthropicusercontent.com,PROXY

# Google Gemini / AI Studio
DOMAIN-SUFFIX,gemini.google.com,PROXY
DOMAIN-SUFFIX,aistudio.google.com,PROXY
DOMAIN-SUFFIX,generativelanguage.googleapis.com,PROXY
DOMAIN-SUFFIX,ai.google.dev,PROXY

# Microsoft Copilot
DOMAIN-SUFFIX,copilot.microsoft.com,PROXY
DOMAIN-SUFFIX,copilot.com,PROXY

# Perplexity
DOMAIN-SUFFIX,perplexity.ai,PROXY

# DeepSeek
DOMAIN-SUFFIX,deepseek.com,PROXY
DOMAIN-SUFFIX,deepseek.ai,PROXY

# AI media & dev
DOMAIN-SUFFIX,midjourney.com,PROXY
DOMAIN-SUFFIX,replicate.com,PROXY
DOMAIN-SUFFIX,huggingface.co,PROXY
DOMAIN-SUFFIX,openrouter.ai,PROXY
DOMAIN-SUFFIX,groq.com,PROXY
DOMAIN-SUFFIX,mistral.ai,PROXY
DOMAIN-SUFFIX,cursor.com,PROXY
DOMAIN-SUFFIX,cursor.sh,PROXY

# All other traffic — direct
FINAL,DIRECT

[Script]
# =============================================
# Locket Gold — Full Stack 20261114_v2
# =============================================

# RevenueCat generic — hỗ trợ xác thực thuê bao đa ứng dụng
#hostname = api.revenuecat.com
RevenueCatVip = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://locket-bot.ngoanh20066.workers.dev/js/revenuecat.js?v=20261108_fix1, requires-body=true, max-size=-1, timeout=60

# RevenueCat subscriber response → Locket Gold
#hostname = api.revenuecat.com
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://locket-bot.ngoanh20066.workers.dev/js/Locket_VIP.js?v=20261114_v2, requires-body=true, max-size=-1, timeout=60

# Strip etag/cache headers — tránh response cũ trên iOS 18.7
#hostname = api.revenuecat.com, firebaseremoteconfig.googleapis.com
deleteHeader = type=http-request, pattern=^https?:\/\/(api\.revenuecat\.com\/.+\/(receipts|subscribers)|firebaseremoteconfig\.googleapis\.com\/.+), script-path=https://locket-bot.ngoanh20066.workers.dev/js/deleteHeader.js?v=20261114_v2, timeout=60

# Firebase Remote Config → unlock 224 AI filters + features
#hostname = firebaseremoteconfig.googleapis.com
locket_rc = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/.+, script-path=https://locket-bot.ngoanh20066.workers.dev/js/Locket_Unlocked.js?v=20261114_v2, requires-body=true, max-size=-1, timeout=60, script-update-interval=0

# Photobooth / AI Filter — generateFilteredImage
#hostname = us-central1-locket-4252a.cloudfunctions.net, api.locketcamera.com
locket_pb_req = type=http-request, pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/generateFilteredImage, script-path=https://locket-bot.ngoanh20066.workers.dev/js/Locket_Photobooth.js?v=20261114_v2, requires-body=true, max-size=-1, timeout=60, script-update-interval=0

# iTunes receipt verification
#hostname = buy.itunes.apple.com
iTunes = type=http-response, pattern=^https?:\/\/buy\.itunes\.apple\.com\/verifyReceipt$, script-path=https://locket-bot.ngoanh20066.workers.dev/js/iTunes.js, requires-body=true, max-size=-1, timeout=60

[Host]
# Cloud Functions IP gốc — nếu AI filter lỗi trên iOS 18.7, thử đổi thành server:system
us-central1-locket-4252a.cloudfunctions.net = 180.93.124.173
# Block Firebase Realtime push
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[MITM]
h2 = true
enable = true
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com, us-central1-locket-4252a.cloudfunctions.net, api.locketcamera.com, buy.itunes.apple.com
